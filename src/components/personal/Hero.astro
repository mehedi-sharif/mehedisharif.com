<section
  id="top"
  class="[min-height:820px] flex flex-col justify-between overflow-hidden"
>
  <div
    class="wrap personal-grid w-full [padding-top:72px] relative [z-index:1]"
  >
    <div class="[grid-column:1_/_span_8] min-w-0 flex flex-col gap-8">
      <span class="lbl">Founder and developer — Bangladesh</span>
      <h1 class="d m-0 [font-size:clamp(48px,_6vw,_92px)] [line-height:0.96]">
        I build products, and the businesses around them.
      </h1>
      <p class="lead [color:#9EA192]">
        I’m Mehedi. I run a few companies, write code, and Now Building GHL
        Megaminds.
      </p>
      <div class="flex flex-wrap items-center gap-7">
        <a class="btn btn-lime" href="#connect"
          >Get in touch <span aria-hidden="true">→</span></a
        >
        <a class="tlink" href="#about">About me</a>
      </div>
    </div>
    <div class="[grid-column:9_/_span_4] min-w-0 self-center"></div>
  </div>
  <img
    width="2880"
    height="900"
    fetchpriority="high"
    src="/images/personal/landscape.png"
    alt=""
    aria-hidden="true"
    class="block w-full [height:340px] [margin-top:-24px] object-cover [object-position:50%_20%]"
  />
</section>

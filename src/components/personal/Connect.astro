<section
  id="connect"
  class="[background:#12170C] [min-height:808px] flex flex-col justify-between"
>
  <div class="wrap personal-grid w-full gap-y-10 pt-[120px] pb-12">
    <div class="sec-head"><span class="lbl"><b>07</b>Connect</span></div>
    <div class="sec-body flex flex-col gap-8">
      <h2 class="d m-0 [font-size:clamp(64px,_9vw,_144px)] [line-height:0.9]">
        Let’s talk.
      </h2>
      <p class="lead muted">
        Based in Bangladesh. Happy to hear about a project, an idea, or just say
        hello.
      </p>
      <div class="flex flex-wrap items-center gap-7">
        <a class="btn btn-lime" href="mailto:hello@example.com"
          >Email me <span aria-hidden="true">→</span></a
        >
        <span class="muted"><span class="ph">[your@email.com]</span></span>
      </div>
    </div>
  </div>
  <img
    width="2880"
    height="900"
    loading="lazy"
    src="/images/personal/landscape.png"
    alt=""
    aria-hidden="true"
    class="block w-full [height:220px] object-cover [object-position:50%_60%] [opacity:0.55] [transform:scaleX(-1)]"
  />
</section>

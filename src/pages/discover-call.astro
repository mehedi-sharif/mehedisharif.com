---
import { getEntry } from "astro:content";
import StagingHome from "@/layouts/StagingHome.astro";

const content = (await getEntry("stagingHome", "-index"))!.data;
const bookingUrl =
  "https://me.mehedisharif.com/widget/booking/uOCX4hGGCPdoXaZ35kuF";
---

<StagingHome
  content={content}
  interior
  title="Book a meeting — Mehedi Sharif"
  description="Choose a convenient time to meet with Mehedi Sharif."
>
  <section class="meet-page wrap" aria-labelledby="meet-heading">
    <div class="meet-intro">
      <h1 id="meet-heading">
        Let’s <i>connect.</i>
      </h1>
      <p>Choose a time that works for you.</p>
    </div>
    <div class="booking-calendar">
      <iframe
        src={bookingUrl}
        title="Book a meeting with Mehedi Sharif"
        allow="payment"
        style="width:100%;height:900px;border:none;overflow:hidden;display:block;"
        scrolling="no"
        id="uOCX4hGGCPdoXaZ35kuF_1794598656925"
      ></iframe>
    </div>
    <p class="booking-fallback">
      <a
        class="cta"
        href={bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="label">Open booking calendar</span>
        <span class="arrow" aria-hidden="true">
          <span>
            <i class="barrow"></i>
          </span>
        </span>
      </a>
    </p>
  </section>
  <script
    is:inline
    src="https://me.mehedisharif.com/js/form_embed.js"
    type="text/javascript"
    defer
  ></script>
</StagingHome>

<style>
  .meet-page {
    padding-block: clamp(104px, 13vw, 168px) 64px;
    min-height: 100svh;
  }
  .meet-intro,
  .booking-calendar,
  .booking-fallback {
    max-width: 1100px;
    margin-inline: auto;
  }
  .meet-intro {
    padding: clamp(36px, 7vw, 88px) 24px;
    margin-bottom: 16px;
    border-radius: var(--radius-card);
    background: var(--brand-teal);
    color: #fff;
    text-align: center;
  }
  .meet-intro h1 {
    margin: 0 0 16px;
    font-size: clamp(44px, 8vw, 92px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .meet-intro h1 i {
    color: var(--brand-lime);
  }
  .meet-intro p {
    font-size: clamp(16px, 2vw, 20px);
  }
  .booking-calendar {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .booking-fallback {
    margin-top: 24px;
    text-align: center;
  }
</style>

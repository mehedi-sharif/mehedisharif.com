---
import ImportedHome from "@/layouts/ImportedHome.astro";
const bookingUrl = "https://me.mehedisharif.com/widget/booking/uOCX4hGGCPdoXaZ35kuF";
---

<ImportedHome
  title="Book a meeting — Mehedi Sharif"
  description="Choose a convenient time to meet with Mehedi Sharif."
>
  <section class="meet-page wrap" aria-labelledby="meet-heading">
    <header class="meet-intro">
      <h1 id="meet-heading" class="d">Let’s connect.</h1>
      <p>Choose a time that works for you.</p>
    </header>
    <div class="booking-calendar">
      <iframe
        src={bookingUrl}
        title="Book a meeting with Mehedi Sharif"
        allow="payment"
        style="width:100%;height:900px;border:none;overflow:hidden;display:block;"
        scrolling="no"
        id="uOCX4hGGCPdoXaZ35kuF_1794598656925"
      ></iframe>
    </div>
    <p class="booking-fallback">
      Having trouble with the calendar? <a href={bookingUrl} target="_blank" rel="noopener noreferrer">Open the booking page</a>.
    </p>
  </section>
  <script is:inline src="https://me.mehedisharif.com/js/form_embed.js" type="text/javascript" defer></script>
</ImportedHome>

<style>
  .meet-page { padding-block: 128px 64px; min-height: 100svh; }
  .meet-intro { text-align: center; margin-bottom: 32px; }
  .meet-intro h1 { margin: 0 0 16px; font-size: clamp(44px, 6vw, 76px); line-height: 1.05; }
  .meet-intro p, .booking-fallback { color: var(--muted); }
  .booking-calendar { max-width: 1100px; margin-inline: auto; background: #fff; border-radius: 16px; overflow: hidden; }
  .booking-fallback { text-align: center; margin-top: 24px; font-size: 14px; }
  .booking-fallback a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 600px) {
    .meet-page { padding-block: 100px 40px; }
    .booking-calendar { border-radius: 12px; }
  }
</style>

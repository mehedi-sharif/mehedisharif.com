---
import { getEntry } from "astro:content";
import StagingHome from "@/layouts/StagingHome.astro";

const content = (await getEntry("stagingHome", "-index"))!.data;
const meetUrl = "https://meet.google.com/vsz-qbbz-fxf";
---

<StagingHome
  content={content}
  interior
  title="Join a call — Mehedi Sharif"
  description="Join Mehedi Sharif on Google Meet."
>
  <section class="join wrap" aria-labelledby="join-heading">
    <div class="join-card">
      <div class="join-photo">
        <img
          class="photo-light"
          src="/images/staging/bust-light.jpg"
          alt="Mehedi Sharif"
          width="420"
          height="560"
        />
        <img
          class="photo-dark"
          src="/images/staging/bust-dark.jpg"
          alt=""
          width="420"
          height="560"
        />
      </div>
      <p class="join-name">Mehedi Sharif</p>
      <h1 id="join-heading">Join a call with <i>Mehedi</i></h1>
      <p class="join-line">You’re joining a Google Meet.</p>
      <a class="cta" href={meetUrl} target="_blank" rel="noopener noreferrer">
        <span class="label">Join Google Meet</span>
        <span class="arrow" aria-hidden="true">
          <span>
            <i class="barrow"></i>
          </span>
        </span>
      </a>
      <p class="join-alt">
        <a href="/discover-call">Need a time instead? Book a call</a>
      </p>
    </div>
  </section>
</StagingHome>

<style>
  .join {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(112px, 16vw, 168px) 0 clamp(72px, 10vw, 120px);
  }
  .join-card {
    width: min(100%, 32rem);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .join-photo {
    width: min(220px, 62vw);
    aspect-ratio: 3 / 4;
    margin-bottom: 28px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #fff;
  }
  .join-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }
  .photo-dark {
    display: none;
  }
  :global([data-theme="dark"]) .photo-light {
    display: none;
  }
  :global([data-theme="dark"]) .photo-dark {
    display: block;
  }
  :global([data-theme="dark"]) .join-photo {
    background: #000;
  }
  .join-name {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .join h1 {
    margin: 0 0 12px;
    max-width: 12ch;
    color: var(--heading);
    font-weight: 300;
    font-size: clamp(2.4rem, 8vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .join-line {
    margin: 0 0 28px;
    font-size: clamp(16px, 2.4vw, 18px);
  }
  .join-alt {
    margin: 22px 0 0;
    font-size: 14px;
  }
  .join-alt a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .join-alt a:hover {
    color: var(--foreground);
  }
  @media (max-width: 600px) {
    .join-photo {
      width: min(180px, 52vw);
      margin-bottom: 22px;
    }
    .join-line {
      margin-bottom: 24px;
    }
  }
</style>

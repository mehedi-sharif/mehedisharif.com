---
import ImportedHome from "@/layouts/ImportedHome.astro";
import ContactDetails from "@/components/ContactDetails.astro";
import { getEntry } from "astro:content";

const contact = (await getEntry("contact", "-index"))!.data;
---

<ImportedHome
  title={contact.meta_title}
  description={contact.description}
  showContactDrawer={false}
>
  <ContactDetails standalone />
</ImportedHome>

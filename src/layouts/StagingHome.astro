---
import config from "@/config/config.json";
import ThemeHead from "@/components/ThemeHead.astro";
import type { CollectionEntry } from "astro:content";
import "@/styles/staging.css";
import "@/styles/fonts.css";
import Drawer from "@/partials/staging/Drawer.astro";
import Header from "@/partials/staging/Header.astro";
import Footer from "@/partials/staging/Footer.astro";
type Props = {
  content: CollectionEntry<"stagingHome">["data"];
  interior?: boolean;
  title?: string;
  description?: string;
  robots?: string;
};
const {
  content,
  interior = false,
  title = content.title,
  description = content.description,
  robots = process.env.CF_PAGES_BRANCH === "staging" ? "noindex" : undefined,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ThemeHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, config.site.base_url).href}
    />
    <link rel="icon" type="image/png" href={config.site.favicon} />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Playfair+Display:ital,wght@1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header content={content.navigation} interior={interior} />
    <main>
      <slot />
    </main>
    <Footer content={content.footer} interior={interior} />
    {!interior && <Drawer />}
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"
    ></script>
    <script is:inline src="/scripts/staging-ui.js"></script>
    <script
      is:inline
      src={
        interior ? "/scripts/staging-contact.js" : "/scripts/staging-home.js"
      }
    ></script>
    <script is:inline src="/scripts/design-contact-form.js"></script>
  </body>
</html>

---
import "@/styles/images.css";
import "@/styles/imported-home.css";
import { AstroFont } from "astro-font";
import Header from "@/partials/imported/Header.astro";
import Footer from "@/partials/imported/Footer.astro";
const { dark = false, title = "Mehedi Sharif — Founder & Builder", description = "Mehedi Sharif — founder of Themefisher, Zeon Studio, SitePins and GHL MegaMinds.", canonical = "https://mehedisharif.com/" } = Astro.props;
---
<!doctype html>
<html lang="en" class:list={{dark}}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/images/favicon.png" />
<AstroFont config={[
 {src:[],preload:true,display:"swap",name:"Inter",fallback:"sans-serif",googleFontsURL:"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"},
 {src:[],preload:true,display:"swap",name:"Cormorant Garamond",fallback:"serif",googleFontsURL:"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"}
]} />
<script is:inline>
 try { const saved=localStorage.getItem('theme'); if(saved) document.documentElement.classList.toggle('dark',saved==='dark'); } catch {}
</script>
</head>
<body>
<Header />
<main id="main-content" style="background:var(--page);color:var(--ink);font-family:Inter,system-ui,sans-serif;font-size:17px;line-height:1.55;overflow-x:clip"><slot /></main>
<Footer />
<script src="/scripts/imported-hill.js" is:inline defer></script>
<script>
 const button=document.querySelector<HTMLButtonElement>('.theme-toggle');
 function updateLabel(){ if(button) { const dark=document.documentElement.classList.contains('dark'); button.setAttribute('aria-checked',String(dark)); button.title=dark?'Switch to light mode':'Switch to dark mode'; } }
 updateLabel();
 button?.addEventListener('click',()=>{ const dark=document.documentElement.classList.toggle('dark'); try {localStorage.setItem('theme',dark?'dark':'light');} catch {} updateLabel(); window.dispatchEvent(new Event('resize')); });
</script>
</body>
</html>

---
import { getEntry } from "astro:content";
import config from "@/config/config.json";
const site = (await getEntry("site", "-index"))!.data;
import ContactDrawer from "@/components/ContactDrawer.astro";
import ThemeHead from "@/components/ThemeHead.astro";
import "@/styles/images.css";
import "@/styles/imported-home.css";
import "@/styles/fonts.css";
import Header from "@/partials/imported/Header.astro";
import Footer from "@/partials/imported/Footer.astro";
const {
  showContactDrawer = true,
  noindex = false,
  title = site.title,
  description = site.description,
  canonical = new URL(Astro.url.pathname, config.site.base_url).href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ThemeHead />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={config.site.favicon} />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-normal.woff2?v=d80df8ff5aec"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-normal.woff2?v=3100e775e861"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Header />
    <main
      id="main-content"
      style="background:var(--page);color:var(--ink);font-family:Inter,system-ui,sans-serif;font-size:17px;line-height:1.55;overflow-x:clip"
    >
      <slot />
    </main>
    <Footer />

    {showContactDrawer && <ContactDrawer />}
  </body>
</html>

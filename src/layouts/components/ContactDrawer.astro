---
import { getEntry } from "astro:content";
const contact = (await getEntry("contact", "-index"))!.data;
import SocialContactLinks from "@/components/SocialContactLinks.astro";
import config from "@/config/config.json";
import "@/styles/contact.css";
---

<dialog
  id="contact-drawer"
  class="contact-panel"
  aria-labelledby="contact-heading"
>
  <button class="contact-close" type="button" aria-label="Close contact form">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </button>
  <div class="contact-panel-content">
    <h2 id="contact-heading">
      {contact.title}
      <br />
      {contact.title_second_line}
    </h2>
    <form class="contact-form" method="POST" action={`https://formsubmit.co/${config.bio.formsubmit_endpoint}`} data-endpoint={`https://formsubmit.co/ajax/${config.bio.formsubmit_endpoint}`} data-success={contact.form.success_message} data-error={contact.form.error_message} data-sending={contact.form.sending_label}>
      <input type="hidden" name="_subject" value={contact.form.email_subject} />
      <div class="contact-field"><label for="full_name">{contact.form.name_label}</label><input id="full_name" name="full_name" type="text" autocomplete="name" placeholder={contact.form.name_placeholder} required /></div>
      <div class="contact-field"><label for="email">{contact.form.email_label}</label><input id="email" name="email" type="email" autocomplete="email" placeholder={contact.form.email_placeholder} required /></div>
      <div class="contact-field"><label for="message">{contact.form.message_label}</label><textarea id="message" name="message" rows="6" placeholder={contact.form.message_placeholder} required /></div>
      <button class="contact-submit" type="submit"><span data-submit-label>{contact.form.submit_label}</span><span aria-hidden="true">↗</span></button>
      <p class="contact-status" role="status" aria-live="polite"></p>
    </form>
    <div class="contact-socials">
      <SocialContactLinks />
    </div>
  </div>
</dialog>
<script>
  let opener: HTMLElement | null = null;
  const getDrawer = () =>
    document.querySelector<HTMLDialogElement>("#contact-drawer");
  function openDrawer(trigger?: HTMLElement) {
    const drawer = getDrawer();
    if (!drawer || drawer.open) return;
    opener = trigger || null;
    drawer.showModal();
  }
  async function closeDrawer() {
    const drawer = getDrawer();
    if (!drawer?.open || drawer.classList.contains("is-closing")) return;
    drawer.classList.add("is-closing");
    // Keep the dialog modal until its exit animation finishes.
    await Promise.allSettled(
      drawer.getAnimations().map((animation) => animation.finished),
    );
    drawer.close();
    drawer.classList.remove("is-closing");
  }
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const close = event.target.closest(".contact-close");
    if (close) {
      void closeDrawer();
      return;
    }
    const link = event.target.closest<HTMLAnchorElement>("a[href]");
    if (
      !link ||
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    )
      return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin) return;
    if (
      url.pathname.replace(/\/$/, "") === "/contact" ||
      link.hasAttribute("data-contact-open")
    ) {
      event.preventDefault();
      openDrawer(link);
    }
  });
  function setup() {
    const drawer = getDrawer();
    if (!drawer || drawer.dataset.ready) return;
    drawer.dataset.ready = "true";
    const form = drawer.querySelector<HTMLFormElement>('.contact-form');
    form?.addEventListener('submit', async event => {
      event.preventDefault();
      if (form.getAttribute('aria-busy') === 'true') return;
      const button = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
      const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
      const status = form.querySelector<HTMLElement>('.contact-status')!;
      const originalLabel = label.textContent;
      const fields = new FormData(form);
      const name = String(fields.get('full_name') || '').trim();
      const email = String(fields.get('email') || '').trim();
      const message = String(fields.get('message') || '').trim();
      if (!name || !email || !message) { status.textContent = form.dataset.error!; status.className = 'contact-status error'; return; }
      button.disabled = true;
      form.setAttribute('aria-busy','true');
      label.textContent = form.dataset.sending!;
      status.textContent = '';
      try {
        const response = await fetch(form.dataset.endpoint!, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body:JSON.stringify({_subject:fields.get('_subject'),name,email,message}),
          signal:AbortSignal.timeout(20000),
        });
        const result = await response.json();
        if (!response.ok || !(result.success === true || result.success === 'true')) throw new Error('Submission failed');
        form.reset(); status.textContent = form.dataset.success!; status.className = 'contact-status success';
      } catch { status.textContent = form.dataset.error!; status.className = 'contact-status error'; }
      finally { button.disabled = false; form.removeAttribute('aria-busy'); label.textContent = originalLabel; }
    });
    drawer.addEventListener("cancel", (event) => {
      event.preventDefault();
      void closeDrawer();
    });
    drawer.addEventListener("close", () => {
      opener?.focus({ preventScroll: true });
      opener = null;
    });
    drawer.addEventListener("click", (event) => {
      if (event.target !== drawer) return;
      const rect = drawer.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        void closeDrawer();
    });
    if (location.pathname.replace(/\/$/, "") === "/contact") openDrawer();
  }
  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .contact-socials {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
</style>

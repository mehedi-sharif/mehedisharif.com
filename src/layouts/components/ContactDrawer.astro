---
import SocialContactLinks from "@/components/SocialContactLinks.astro";
import ContactForm from "@/helpers/ContactForm";
import "@/styles/contact.css";
---
<dialog id="contact-drawer" class="contact-panel" aria-labelledby="contact-heading">
  <button class="contact-close" type="button" aria-label="Close contact form">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5" /></svg>
  </button>
  <div class="contact-panel-content">
    <h2 id="contact-heading">Let’s work<br />together.</h2>
    <ContactForm client:load />
    <div class="contact-socials"><SocialContactLinks /></div>
  </div>
</dialog>
<script>
  let opener: HTMLElement | null = null;
  const getDrawer = () => document.querySelector<HTMLDialogElement>('#contact-drawer');
  function openDrawer(trigger?: HTMLElement) {
    const drawer = getDrawer();
    if (!drawer || drawer.open) return;
    opener = trigger || null;
    drawer.showModal();
  }
  async function closeDrawer() {
    const drawer = getDrawer();
    if (!drawer?.open || drawer.classList.contains('is-closing')) return;
    drawer.classList.add('is-closing');
    // Keep the dialog modal until its exit animation finishes.
    await Promise.allSettled(drawer.getAnimations().map(animation => animation.finished));
    drawer.close();
    drawer.classList.remove('is-closing');
  }
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return;
    const close = event.target.closest('.contact-close');
    if (close) { void closeDrawer(); return; }
    const link = event.target.closest<HTMLAnchorElement>('a[href]');
    if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin) return;
    if (url.pathname.replace(/\/$/, '') === '/contact' || link.hasAttribute('data-contact-open')) {
      event.preventDefault();
      openDrawer(link);
    }
  });
  function setup() {
    const drawer = getDrawer();
    if (!drawer || drawer.dataset.ready) return;
    drawer.dataset.ready = 'true';
    drawer.addEventListener('cancel', event => { event.preventDefault(); void closeDrawer(); });
    drawer.addEventListener('close', () => { opener?.focus({preventScroll:true}); opener = null; });
    drawer.addEventListener('click', event => {
      if(event.target !== drawer) return;
      const rect = drawer.getBoundingClientRect();
      if(event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) void closeDrawer();
    });
    if(location.pathname.replace(/\/$/, '') === '/contact') openDrawer();
  }
  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>.contact-socials { margin-top:32px;padding-top:24px;border-top:1px solid var(--rule); }</style>

---
import { getEntry } from "astro:content";
const site = (await getEntry("site", "-index"))!.data;
const icons: Record<string, string> = {
  facebook:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-9h3l.5-3h-3.5V8c0-.9.3-1.5 1.6-1.5H17V3.8a20 20 0 0 0-2.6-.2c-2.6 0-4.4 1.6-4.4 4.6V10H7v3h3v9z"/></svg>',
  linkedin:
    '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" fill="currentColor"></path></svg>',
  x: '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z" fill="currentColor"></path></svg>',
  github:
    '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.04c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3" fill="currentColor"></path></svg>',
};
---

<div class="social-contact-links">
  <div class="social-icons">
    {site.socials.map((social) => (
      <a
        class="soc"
        href={social.link}
        target="_blank"
        rel="noopener"
        aria-label={`${site.name} on ${social.name}`}
      >
        <Fragment set:html={icons[social.icon] || icons.facebook} />
      </a>
    ))}
  </div>
  <a
    class="calendar-link"
    href={site.calendar.link}
    target="_blank"
    rel="noopener"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M16 3v4M8 3v4M3 11h18m-13 4h3m2 0h3" />
    </svg>
    {site.calendar.label}
  </a>
</div>
<style>
  .social-contact-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .social-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .soc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--ink);
    text-decoration: none;
  }
  .soc:hover {
    background: #d4ff24;
    color: #030407;
    border-color: #d4ff24;
  }
  .calendar-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--ink);
    font:
      500 14px/1.4 Inter,
      sans-serif;
    text-underline-offset: 4px;
    text-decoration-color: var(--link-rule, #d4ff24);
  }
  a:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 4px;
  }
</style>

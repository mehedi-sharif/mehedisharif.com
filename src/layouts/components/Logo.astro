---
import config from "@/config/config.json";

const { logo, logo_darkmode, logo_width, logo_height, logo_text, title } = config.site;
const { theme_switcher } = config.settings;
const width = parseInt(logo_width, 10);
const height = parseInt(logo_height, 10);
---

<a href="/" class="navbar-brand inline-block">
  {
    logo || logo_darkmode ? (
      <>
        <img
          src={logo}
          class={`inline-block ${theme_switcher ? "dark:hidden" : ""}`}
          width={width}
          height={height}
          alt={title}
        />
        {theme_switcher && (
          <img
            src={logo_darkmode}
            class="hidden dark:inline-block"
            width={width}
            height={height}
            alt={title}
          />
        )}
      </>
    ) : (logo_text || title)
  }
</a>

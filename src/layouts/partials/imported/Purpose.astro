---
import { getEntry } from "astro:content";
const { businesses } = (await getEntry("homepage", "-index"))!.data;
---

{businesses.enable && (
  <section
    id="purpose"
    class="wrap grid screen"
    style="row-gap: 40px; padding-top: 80px; padding-bottom: 80px"
  >
    <div class="sec-head">
      <span class="tag">{businesses.label}</span>
    </div>
    <div class="sec-body">
      <h2 class="d h2" style="padding-bottom: 40px">
        {businesses.title}
      </h2>
      {businesses.items.map((item, index) => (
        <article
          class="chapter"
          style={`padding:22px 0;${index === businesses.items.length - 1 ? "border-bottom:1px solid var(--rule)" : ""}`}
        >
          <span
            class:list={{ lbl: !item.featured }}
            style="grid-column:1 / span 2"
          >
            {item.featured ? (
              <span class="nowpill">
                <i></i>
                {item.period}
              </span>
            ) : (
              item.period
            )}
          </span>
          <div style="grid-column:3 / span 3;display:flex;flex-direction:column">
            <h3
              class="d"
              style="margin:0;font-size:var(--business-heading-size,28px);line-height:1.1"
            >
              {item.title}
            </h3>
            <a class="slink" href={item.link} target="_blank" rel="noopener">
              {item.link_label} ↗
            </a>
          </div>
          <p
            class:list={{ muted: !item.featured }}
            style="grid-column:6 / span 4;margin:0;font-size:var(--section-body-size,16px);line-height:1.5"
          >
            {item.description}
          </p>
        </article>
      ))}
    </div>
  </section>
)}

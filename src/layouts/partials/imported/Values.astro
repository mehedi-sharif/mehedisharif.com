---
import { getEntry } from "astro:content";
const { values } = (await getEntry("homepage", "-index"))!.data;
---

{values.enable && (
  <section id="values" style="background: var(--surface)">
    <div
      class="wrap screen"
      style="display: grid; padding-top: 120px; padding-bottom: 120px"
    >
      <div style="min-width: 0">
        <div style="display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; padding-bottom: 64px">
          <span class="tag">{values.label}</span>
          <h2 class="d h2">{values.title}</h2>
        </div>
        <div class="vgrid">
          {values.items.map((item, index) => (
            <div class="vcell">
              <span
                class="lbl"
                style="color: var(--accent-text); font-size: 12px; font-style: italic"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3
                class="d"
                style="margin: 0; font-size: var(--value-heading-size, 24px); line-height: 1.2"
              >
                {item.title}
              </h3>
              <p
                class="muted"
                style="margin: 0; font-size: var(--section-body-size, 16px); line-height: 1.55"
              >
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

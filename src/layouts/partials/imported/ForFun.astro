---
import ContentImage from "@/components/ContentImage.astro";
import { getEntry } from "astro:content";
const { interests } = (await getEntry("homepage", "-index"))!.data;
---

{interests.enable && (
  <section
    id="for-fun"
    class="wrap grid screen"
    style="row-gap: 40px; padding-top: 80px; padding-bottom: 80px"
  >
    <div class="sec-head">
      <span class="tag">{interests.label}</span>
    </div>
    <div
      class="sec-body"
      style="display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); column-gap: 24px; row-gap: 24px"
    >
      <h2
        class="d h2"
        style="grid-column: 1 / span 6; text-decoration-line: none; padding-bottom: 16px"
      >
        {interests.title}
      </h2>

      {interests.images.map((photo, index) => (
        <div
          class="leisure-photo"
          style={
            index % 2 === 0
              ? "grid-column:1 / span 5;aspect-ratio:5 / 4"
              : "grid-column:6 / span 4;aspect-ratio:4 / 5;align-self:end"
          }
        >
          <ContentImage
            src={photo.image}
            alt={photo.alt}
            width="1200"
            height="1200"
            sizes="(max-width: 900px) calc(100vw - 32px), 620px"

          />
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .leisure-photo {
    overflow: hidden;
    border-radius: 16px;
    min-width: 0;
  }
  .leisure-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>

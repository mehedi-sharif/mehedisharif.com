---
import { getEntry } from "astro:content";
const { banner } = (await getEntry("homepage", "-index"))!.data;
---

<section
  id="top"
  class="hero-banner"
  style="position: relative; min-height: 840px; display: flex; flex-direction: column; overflow: hidden"
>
  <div
    class="wrap grid hero-content"
    style="width: 100%; padding-top: 96px; position: relative; z-index: 1"
  >
    <div style="grid-column: 1 / -1; min-width: 0; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 32px; max-width: 980px; margin: 0 auto">
      <span class="lbl">{banner.label}</span>
      <h1
        class="d"
        style="margin: 0; font-size: clamp(48px, 6vw, 92px); line-height: 0.96"
      >
        {banner.title}
        <br />
        {banner.title_second_line}
      </h1>
      <p class="lead" style="color: var(--muted)">
        {banner.description}
      </p>
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 28px">
        <a class="btn btn-lime" href={banner.primary_button.link}>
          {banner.primary_button.label} <span aria-hidden="true">→</span>
        </a>
        <a
          class="tlink"
          href={banner.secondary_button.link}
          aria-haspopup="dialog"
          aria-controls="contact-drawer"
        >
          {banner.secondary_button.label}
        </a>
      </div>
    </div>
  </div>
  <div
    class="hero-hills"
    style="position: absolute; left: 0; right: 0; bottom: 0; height: 440px; pointer-events: none; -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 62%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 62%, transparent 100%)"
  >
    <canvas
      id="hill"
      aria-hidden="true"
      style="display: block; width: 100%; height: 100%; --hill-ink: var(--hill-ink-color); --hill-op: var(--hill-opacity)"
    ></canvas>
  </div>
</section>

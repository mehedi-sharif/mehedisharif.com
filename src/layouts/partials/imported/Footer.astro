---
import "../../../styles/navigation-tailwind.css";
import { getEntry } from "astro:content";
const site = (await getEntry("site", "-index"))!.data;
import SocialContactLinks from "@/components/SocialContactLinks.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
---

<footer class="wrap site-footer tw:grid tw:grid-cols-1 tw:items-center tw:gap-x-4 tw:gap-y-6 tw:text-sm tw:md:grid-cols-[1fr_auto_1fr]">
  <span class="tw:justify-self-center tw:md:justify-self-start">
    <a
      href={
        Astro.url.pathname.startsWith("/blog")
          ? "#blog-top"
          : Astro.url.pathname.startsWith("/posts/")
            ? "#post"
            : /^\/contact\/?$/.test(Astro.url.pathname)
              ? "#main-content"
              : "#top"
      }
      aria-label={`${site.name}, back to top`}
      style="display: inline-flex; color: var(--ink)"
    >
      <img
        class="footer-signature"
        src={site.footer_logo}
        width="130"
        height="30"
        alt=""
      />
    </a>
  </span>
  <ThemeSwitcher />
  <div class="tw:md:justify-self-end">
    <SocialContactLinks showCalendar={false} />
  </div>
</footer>

---
const homePrefix = Astro.url.pathname === "/" || Astro.url.pathname === "/dark" || Astro.url.pathname === "/dark/" ? "" : "/";
const isBlog = Astro.url.pathname.startsWith("/blog");
---
<header class="topbar">
  <nav class="mnav" aria-label="Main">
    <a href={homePrefix + "#top"} class="logo" aria-label="Mehedi Sharif, home"><img src="/images/logo-light.svg" width="160" height="37" alt="" /></a>
    <div class="section-links">
      <a class="ml" href={homePrefix + "#top"}>Home</a>
      <a class="ml" href={homePrefix + "#about"}>About</a>
      <a class="ml" href={homePrefix + "#values"}>Values</a>
      <a class="ml" href={homePrefix + "#purpose"}>Businesses</a>
      <a class="ml" href={homePrefix + "#for-fun"}>For fun</a>
      <a class:list={["ml", { "current": isBlog }]} aria-current={isBlog ? "page" : undefined} href="/blog">Blog</a>
    </div>
    <a class="mc" href={homePrefix + "#connect"}>Contact</a>
  </nav>
</header>

---
import type { CollectionEntry } from "astro:content";
type Props = { content: CollectionEntry<"stagingHome">["data"]["blog"] };
const { content } = Astro.props;
---

<!-- BLOG — from mehedisharif.com/blog -->
<section id="blog">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>
        {content.title_before}{" "}
        <span class="hl">
          <i>{content.title_highlight}</i>
        </span>
      </h2>
      <p class="blog-sub">{content.description}</p>
    </div>
    <div class="posts">
      {content.posts.map((post) => (
        <a class="post reveal" href={post.link}>
          <span class="cat">{post.category}</span>
          <div>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </div>
          <span class="read">
            {post.reading_time}{" "}
            <b>
              <span class="barrow" aria-hidden="true"></span>
            </b>
          </span>
        </a>
      ))}
    </div>
    <div class="blog-all reveal">
      <a href={content.button.link} class="cta">
        <span class="label">{content.button.label}</span>
        <span class="arrow" aria-hidden="true">
          <span>
            <i class="barrow"></i>
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

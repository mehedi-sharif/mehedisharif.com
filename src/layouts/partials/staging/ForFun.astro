---
import type { CollectionEntry } from "astro:content";
type Props = { content: CollectionEntry<"stagingHome">["data"]["interests"] };
const { content } = Astro.props;
---

<!-- FUN -->
<section id="for-fun">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>
        {content.title_before}{" "}
        <span class="hl">
          <i>{content.title_highlight}</i>
        </span>
      </h2>
    </div>
    <!-- Name Cloud, our way: a short story set big; hover a highlighted word
           and it lights up while a small card follows the cursor -->
    <p class="story reveal" id="story">
      {content.story.map((item, index) => (
        <Fragment>
          {item.before.endsWith(" ") ? item.before : item.before + " "}
          <span class="hw" data-peek={index}>
            <i>{item.highlight}</i>
          </span>
        </Fragment>
      ))}
      {content.story_end}
    </p>
    <div class="peek" id="peek" aria-hidden="true">
      {content.story.map((item, index) => (
        <img data-k={index} src={item.image} alt="" />
      ))}
    </div>
  </div>
</section>

---
import type { CollectionEntry } from "astro:content";
type Props = { content: CollectionEntry<"stagingHome">["data"]["businesses"] };
const { content } = Astro.props;
---

<!-- PURPOSE -->
<section id="purpose">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2>
        {content.title_before}{" "}
        <span class="hl">
          <i class="pf">{content.rotating_words[0]}</i>
        </span>
      </h2>
    </div>
    <div class="biz">
      {content.items.map((item) => (
        <div class:list={["card row reveal", { now: item.featured }]}>
          <div class="when">
            {item.featured ? (
              <span class="pill">{item.period}</span>
            ) : (
              item.period
            )}
          </div>
          <div>
            <h3>{item.title}</h3>
            <a class="url" href={item.link} target="_blank" rel="noopener">
              {item.label}
            </a>
          </div>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

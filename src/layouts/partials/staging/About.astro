---
import type { CollectionEntry } from "astro:content";
import BoldText from "./BoldText.astro";
type Props = { content: CollectionEntry<"stagingHome">["data"]["about"] };
const { content } = Astro.props;
---

<!-- ABOUT — founder parks on the left, story on the right -->
<section id="about">
  <div class="wrap about">
    <div class="about-slot" id="aboutSlot" aria-hidden="true"></div>
    <div class="about-text" id="aboutText">
      <h2 class="reveal">
        {content.title_lines.map((line) => (
          <Fragment>
            {line}
            <br />
          </Fragment>
        ))}
        <span class="hl">
          <i>{content.title_highlight}</i>
        </span>
      </h2>
      <div class="reveal">
        {content.paragraphs.map((paragraph) => (
          <p>
            <BoldText text={paragraph} />
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

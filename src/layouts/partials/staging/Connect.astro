---
import type { CollectionEntry } from "astro:content";
type Props = { content: CollectionEntry<"stagingHome">["data"]["connect"] };
const { content } = Astro.props;
---

<!-- CONNECT -->
<section id="connect">
  <div class="wrap reveal">
    <h2>
      {content.title_before}{" "}
      <span class="hl">
        <i>{content.title_highlight}</i>
      </span>
    </h2>
    <p>{content.description}</p>
    <a href={content.button.link} class="cta">
      <span class="label">{content.button.label}</span>
      <span class="arrow" aria-hidden="true">
        <span>
          <i class="barrow"></i>
        </span>
      </span>
    </a>
  </div>
</section>

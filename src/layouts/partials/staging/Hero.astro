      </div>
    </div>
    <div class="h-request reveal">
      <a href="#about" class="cta">
        <span class="label">My story</span>
        <span class="arrow" aria-hidden="true">
          <span>
            <svg viewBox="0 0 9 7.364">
              <path d="M0.5 3.682h7.5M5.318 0.5l3.182 3.182-3.182 3.182" />
            </svg>
          </span>
        </span>
      </a>
    </div>
    <div class="h-connect reveal">
      <a href="https://mehedisharif.com/contact" class="cta">
        <span class="label">Let’s connect</span>
        <span class="arrow" aria-hidden="true">
          <span>
            <svg viewBox="0 0 9 7.364">
              <path d="M0.5 3.682h7.5M5.318 0.5l3.182 3.182-3.182 3.182" />
            </svg>
          </span>
        </span>
      </a>
    </div>
    <a
      class="h-trust reveal"
      href="https://ghlmegaminds.com/"
      target="_blank"
      rel="noopener"
    >
      <span class="dot"></span>Now building <i>GHLMegaMinds</i> ↗

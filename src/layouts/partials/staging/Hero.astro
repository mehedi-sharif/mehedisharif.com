<!-- HERO — Stackside composition: headline top-left, copy on a rule,
       2×2 stats right, request row at the bottom, founder centred behind -->
<div class="figure" id="figure" aria-hidden="true">
  <img
    id="bustPoster"
    src="/images/staging/bust-light.jpg"
    data-light="/images/staging/bust-light.jpg"
    data-dark="/images/staging/bust-dark.jpg"
    alt=""
  />
  <canvas id="bust"></canvas>
</div>
<canvas class="halftone" id="halftone" aria-hidden="true"></canvas>
<section id="top">
  <div class="stage">
    <div class="figure-spot" id="figureSpot" aria-hidden="true"></div>
    <div class="h-left">
      <div class="h-head">
        <h1 class="split" id="title">
          I am a chain{" "}
          <span class="hl">
            <i>Breaker</i>
          </span>{" "}
          and build businesses that matter
        </h1>
      </div>
      <div class="h-copy">
        <span class="rule reveal"></span>
        <div>
          <p class="lead reveal">Mehedi Sharif</p>
          <p class="body reveal">
            <b>2×</b> exited founder. Built <b>Themefisher</b> from a startup
            into a <b>$2 million</b> business, acquired <b>UIHut</b>, and built{" "}
            <b>Zeon Studio</b> agency. Now I’m building the next chapter with{" "}
            <b>GHLMegaMinds</b>.

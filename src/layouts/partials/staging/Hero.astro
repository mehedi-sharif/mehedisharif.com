---
import type { CollectionEntry } from "astro:content";
import BoldText from "./BoldText.astro";
type Props = { content: CollectionEntry<"stagingHome">["data"]["hero"] };
const { content } = Astro.props;
---

<!-- HERO — Stackside composition: headline top-left, copy on a rule,
       2×2 stats right, request row at the bottom, founder centred behind -->
<div class="figure" id="figure" aria-hidden="true">
  <img
    id="bustPoster"
    src={content.portrait_light}
    data-light={content.portrait_light}
    data-dark={content.portrait_dark}
    data-animate={String(content.animate_portrait)}
    alt=""
  />
  <canvas id="bust"></canvas>
</div>
<canvas class="halftone" id="halftone" aria-hidden="true"></canvas>
<section id="top">
  <div class="stage">
    <div class="figure-spot" id="figureSpot" aria-hidden="true"></div>
    <div class="h-left">
      <div class="h-head">
        <h1 class="split" id="title">
          {content.title_before}{" "}
          <span class="hl">
            <i>{content.title_highlight}</i>
          </span>{" "}
          {content.title_after}
        </h1>
      </div>
      <div class="h-copy">
        <span class="rule reveal"></span>
        <div>
          <p class="lead reveal">{content.name}</p>
          <p class="body reveal">
            <BoldText text={content.description} />
          </p>
        </div>
      </div>
    </div>
    <div class="h-request reveal">
      <a href={content.primary_button.link} class="cta">
        <span class="label">{content.primary_button.label}</span>
        <span class="arrow" aria-hidden="true">
          <span>
            <i class="barrow"></i>
          </span>
        </span>
      </a>
    </div>
    <a
      class="h-trust reveal"
      href={content.spotlight.link}
      target="_blank"
      rel="noopener"
    >
      <span class="dot"></span>
      {content.spotlight.label} <i>{content.spotlight.name}</i> ↗
    </a>
  </div>
</section>

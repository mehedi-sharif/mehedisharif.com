---
import type { CollectionEntry } from "astro:content";
type Props = { content: CollectionEntry<"stagingHome">["data"]["footer"] };
const { content } = Astro.props;
const icons: Record<string, string> = {
  facebook:
    "M14 8h3V4h-3c-2.8 0-4 1.7-4 4.3V10H7v4h3v8h4v-8h3l1-4h-4V8.6c0-.4.3-.6.6-.6z",
  linkedin:
    "M4 9h4v12H4zM6 3a2 2 0 110 4 2 2 0 010-4zm4 6h4v1.7c.6-1 1.9-2 3.9-2 4 0 4.1 2.7 4.1 6.1V21h-4v-5.6c0-1.4 0-3.1-1.900-3.1s-2.1 1.5-2.1 3V21h-4z",
  x: "M17.8 3h3.3l-7.2 8.2L22.3 21h-6.6l-5.2-6.8L4.6 21H1.3l7.7-8.8L1 3h6.8l4.7 6.2zm-1.2 16h1.8L7 4.9H5.1z",
  github:
    "M12 2a10 10 0 00-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.100-4.6-5 0-1.100.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 015 0c1.900-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.900-2.4 4.700-4.6 5 .4.3.7.9.7 1.900V21c0 .3.2.6.7.5A10 10 0 0012 2z",
};
---

<footer>
  <div class="card foot">
    <a href={content.brand.link} class="brand" aria-label={content.brand.label}>
      <span class="mark">
        <span></span>
      </span>
      <img src={content.brand.image} alt="" />
    </a>
    <div class="socials">
      {content.socials.map((social) => (
        <a
          href={social.link}
          target="_blank"
          rel="noopener"
          aria-label={social.label}
        >
          {icons[social.icon] ? (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[social.icon]} />
            </svg>
          ) : (
            social.name
          )}
        </a>
      ))}
    </div>
    <a href={content.booking.link} class="book">
      {content.booking.label}
    </a>
  </div>
</footer>

---
import type { CollectionEntry } from "astro:content";
type Props = { content: CollectionEntry<"stagingHome">["data"]["values"] };
const { content } = Astro.props;
/* blob in the round sticker: kept to the edge so the dark icon always sits on the light colour */
const vDot = [
  "M54 24C45 29 41 41 43 54H54Z",
  "M0 33c11-1 20 7 22 21H0Z",
  "M28 0c1 11 12 19 26 19V0Z",
];
const vIcon = [
  '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01M15 9h.01"/>',
  '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  '<path d="M22 7 13.5 15.5 8.5 10.5 2 17"/><path d="M16 7h6v6"/>',
  '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  '<circle cx="12" cy="12" r="8"/>',
  '<path d="M6 8.5a6.5 6.5 0 1 1 13 0c0 6-6 6-6 10a3.5 3.5 0 1 1-7 0"/><path d="M15 8.5a2.5 2.5 0 0 0-5 0v1a2 2 0 1 1 0 4"/>',
  '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  '<circle cx="12" cy="12" r="3"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><path d="M10.4 21.9a10 10 0 0 0 9.941-15.416M13.5 2.1a10 10 0 0 0-9.841 15.416"/>',
  '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/><path d="M20 3v4M22 5h-4"/>',
];
---

<!-- VALUES -->
<section id="values">
  <div class="v-stage">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>
          {content.title_before}{" "}
          <span class="hl">
            <i>{content.title_highlight}</i>
          </span>{" "}
          {content.title_after}
        </h2>
      </div>
    </div>
    <div class="values" id="valueList">
      {content.items.map((item, index) => (
        <div class="card val reveal">
          <div class="v-badge" aria-hidden="true">
            <span class="ic">
              <svg class="cb" viewBox="0 0 54 54">
                <rect width="54" height="54" fill="var(--brand-lime)" />
                <path d={vDot[index % vDot.length]} fill="var(--brand-teal)" />
              </svg>
              <svg viewBox="0 0 24 24" set:html={vIcon[index % vIcon.length]} />
            </span>
          </div>
          <div>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

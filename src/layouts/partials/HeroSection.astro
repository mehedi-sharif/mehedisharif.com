---
import HillBackground from "@/components/HillBackground.astro";
import { getEntry } from "astro:content";

const heroBanner = await getEntry("homepage", "-index");
const { bio } = heroBanner?.data?.banner;
---

<section class="banner relative isolate">
  <div class="container relative z-10 text-center">
    <div class="hero-copy mx-auto">
      <h1>{bio}</h1>
      <p class="type-lead mx-auto mt-6 max-w-2xl">I’m Mehedi, a founder and developer based in Bangladesh. I run a few companies, write code, and am now building GHL MegaMinds.</p>
      <a class="btn mt-8" href="/contact">Get in touch</a>
    </div>
  </div>
  <div class="hero-hills" aria-hidden="true">
    <HillBackground />
  </div>
</section>

<style>
  .banner {
    min-height: calc(100svh - 106px);
    padding-top: clamp(20px, 4vh, 40px);
    padding-bottom: 180px;
    clip-path: inset(-100px -100vw 0);
  }
  .hero-copy { max-width: 1000px; }
  .hero-copy h1, .hero-copy p {
    text-shadow: 0 0 12px #fff, 0 0 24px #fff;
  }
  :global(.dark) .hero-copy h1, :global(.dark) .hero-copy p {
    text-shadow: 0 0 12px #101725, 0 0 24px #101725;
  }
  .hero-copy .btn { background-color: var(--color-body, #fff); }
  :global(.dark) .hero-copy .btn { background-color: var(--color-darkmode-body, #101725); }
  .hero-copy .btn:hover { background-color: #000; }
  :global(.dark) .hero-copy .btn:hover { background-color: #fff; }
  .hero-hills {
    position: absolute;
    bottom: -120px;
    left: 50%;
    width: 100vw;
    height: clamp(440px, 78svh, 740px);
    transform: translateX(-50%);
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .banner { min-height: auto; padding-top: 16px; padding-bottom: 0; }
    .hero-copy { padding-inline: 12px; }
    .hero-copy h1 { font-size: clamp(38px, 10.8vw, 56px); line-height: 1; }
    .hero-copy .type-lead { font-size: 18px; line-height: 1.55; }
    .hero-copy .btn { margin-top: 24px; }
    .hero-hills { position: relative; bottom: auto; height: 300px; margin-top: -20px; }
  }
  @media (max-width: 359px) {
    .hero-copy h1 { font-size: 36px; }
    .hero-copy .type-lead { font-size: 17px; }
    .hero-hills { height: 260px; }
  }
</style>

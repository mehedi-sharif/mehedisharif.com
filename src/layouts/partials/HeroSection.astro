---
import HillBackground from "@/components/HillBackground.astro";
import ImageMod from "@/components/ImageMod.astro";
import { getEntry } from "astro:content";

const heroBanner = await getEntry("homepage", "-index");
const { image, bio } = heroBanner?.data?.banner;
---

<section class="section banner relative isolate pb-0">
  <HillBackground />
  <div class="container relative z-10">
    <div
      class="mb-16 grid grid-cols-1 items-center text-center md:grid-cols-2 md:text-left"
    >
      <div class="hero-copy relative mt-12 md:mt-0">
        <h1
          class="order-last md:order-first"
        >
          {bio}
        </h1>
        <p class="type-lead mt-6 max-w-2xl">I’m Mehedi, a founder and developer based in Bangladesh. I run a few companies, write code, and am now building GHL MegaMinds.</p>
        <a class="btn mt-8" href="/contact">Get in touch</a>
      </div>

      <div
        class="order-first flex w-full items-center justify-center md:order-last"
      >
        <div class="relative h-[279px] w-[252px]">
          <ImageMod
            class="block dark:hidden"
            src="/images/author.png"
            alt=""
            width={252}
            height={279}
            format="webp"
            loading="eager"
          />
          <ImageMod
            class="hidden dark:block"
            src="/images/author-light.png"
            alt=""
            width={252}
            height={279}
            format="webp"
            loading="eager"
          />
          <ImageMod
            class="absolute left-[15px] top-[15px] h-[216px] w-[216px] rounded-full object-cover object-center"
            src={image}
            alt="Mehedi Sharif"
            width={504}
            height={672}
            format="webp"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-copy::before {
    content: "";
    position: absolute;
    inset: -2rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse, rgba(255,255,255,.96) 25%, rgba(255,255,255,.8) 55%, transparent 74%);
  }
  :global(.dark) .hero-copy::before {
    background: radial-gradient(ellipse, rgba(16,23,37,.96) 25%, rgba(16,23,37,.8) 55%, transparent 74%);
  }
</style>

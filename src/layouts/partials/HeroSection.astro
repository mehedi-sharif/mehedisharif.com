---
import ImageMod from "@/components/ImageMod.astro";
import { getEntry } from "astro:content";

const heroBanner = await getEntry("homepage", "-index");
const { image, bio } = heroBanner?.data?.banner;
---

<section class="section banner pb-0">
  <div class="container">
    <div
      class="mb-16 flex flex-col items-center text-center md:flex-row md:text-left"
    >
      <div class="mt-12 md:mt-0">
        <h1
          class="order-last text-[1.5rem] font-semibold md:order-first md:text-h1 2xl:text-[2.4rem]"
        >
          {bio}
        </h1>
        <p class="mt-6 max-w-2xl">I’m Mehedi, a founder and developer based in Bangladesh. I run a few companies, write code, and am now building GHL MegaMinds.</p>
        <a class="btn mt-8" href="/contact">Get in touch</a>
      </div>

      <div
        class="order-first mx-auto block w-1/2 text-center md:order-last md:w-[50%] lg:w-4/5 xl:w-[55%] 2xl:w-4/5"
      >
        <div class="relative h-[279px] w-[252px]">
          <ImageMod
            class="block dark:hidden"
            src="/images/author.png"
            alt=""
            width={252}
            height={279}
            format="webp"
            loading="eager"
          />
          <ImageMod
            class="hidden dark:block"
            src="/images/author-light.png"
            alt=""
            width={252}
            height={279}
            format="webp"
            loading="eager"
          />
          <ImageMod
            class="absolute left-[15px] top-[15px] h-[216px] w-[216px] rounded-full object-cover object-center"
            src={image}
            alt="Mehedi Sharif"
            width={504}
            height={672}
            format="webp"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

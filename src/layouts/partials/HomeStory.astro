---
import homepage from "../../data/homepage.json";
---

<section id="about" class="section">
  <div class="container">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_2fr] md:gap-16">
      <img src="/images/personal/portrait.jpg" alt="Mehedi Sharif" width="724" height="1056" loading="lazy" class="mx-auto aspect-[5/6] w-full max-w-sm rounded-xl object-cover object-top" />
      <div>
        <h3 class="mb-6 text-h3">Based in Bangladesh. Building for the web.</h3>
        <p class="mb-5">I’m a founder and developer. I like making useful things and then building the business that keeps them going.</p>
        <p>My companies are Themefisher, UIHut, Zeon Studio and SitePins. Right now most of my time goes into GHL MegaMinds, my newest venture. I’m also a GoHighLevel Certified Admin.</p>
      </div>
    </div>
  </div>
</section>
<section id="purpose" class="section">
  <div class="container">
    <h2 class="section-title mb-10">I am a <strong>builder</strong></h2>
    <div class="space-y-7">
      {homepage.ventures.map((venture) => (
        <article class="relative rounded-xl border transition duration-200 ease-out hover:border-dark dark:border-darkmode-border dark:hover:border-slate-600 grid gap-5 p-6 md:grid-cols-[1fr_2fr] md:gap-10 md:p-9">
          <div>
            <p class="type-label mb-3">{venture.period}</p>
            <h3 class="text-h4">{venture.url ? <a class="underline decoration-1 underline-offset-4" href={venture.url} target="_blank" rel="noopener noreferrer">{venture.name} ↗</a> : venture.name}</h3>
          </div>
          <p>{venture.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<section id="values" class="section">
  <div class="container">
    <h2 class="section-title mb-10">What I <strong>believe in</strong></h2>
    <div class="space-y-7">
      {homepage.values.map((value, index) => (
        <article class="relative rounded-xl border transition duration-200 ease-out hover:border-dark dark:border-darkmode-border dark:hover:border-slate-600 grid gap-5 p-6 md:grid-cols-[1fr_2fr] md:gap-10 md:p-9">
          <div>
            <p class="type-label mb-3" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="text-h4">{value.title}</h3>
          </div>
          <p>{value.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
